          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ikke nå"
          }
        }
      }
    },
    "journey_rationale_privacy": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your location stays on this device and is never sent anywhere."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Posisjonen din blir på denne enheten og sendes aldri noe sted."
          }
        }
      }
    },
