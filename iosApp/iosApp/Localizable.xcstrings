    "journey_ios_time_limit": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Without location, iOS pauses PulseTransit soon after you leave it. Alerts then come at the times known when it was last open, so later delays and faster routes are missed."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Uten posisjon setter iOS PulseTransit på pause kort tid etter at du forlater appen. Varslene kommer da til tidene som var kjent sist appen var åpen, så senere forsinkelser og raskere ruter fanges ikke opp."
          }
        }
      }
    },
