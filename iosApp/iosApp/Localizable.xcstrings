    "data_sources_intro": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Departures and routes come from Entur, the national registry of public transport in Norway. These companies share their timetables with it. If a company isn’t listed, PulseTransit can’t show its departures."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Avganger og reiser kommer fra Entur, det nasjonale registeret for kollektivtrafikk i Norge. Disse selskapene deler rutetidene sine med Entur. Står ikke et selskap på lista, kan ikke PulseTransit vise avgangene deres."
          }
        }
      }
    },
    "data_sources_no_match": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No company matches “%1$@”. Companies that aren’t in Entur aren’t shown in PulseTransit."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen selskaper passer til «%1$@». Selskaper som ikke er i Entur, vises ikke i PulseTransit."
          }
        }
      }
    },
    "data_sources_row": {
      "extractionState": "manual",
