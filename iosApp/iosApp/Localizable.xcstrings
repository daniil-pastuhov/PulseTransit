    "location_denied": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Location access is needed to show routes and stops from where you are."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Posisjonstilgang trengs for å vise reiser og stoppesteder der du er."
          }
        }
      }
    },
    "location_needed_body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Location access is needed to show routes and stops from where you are. Turn it on in your phone’s settings, or go on without it and search for routes yourself."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Posisjonstilgang trengs for å vise reiser og holdeplasser fra der du er. Slå den på i telefonens innstillinger, eller fortsett uten og søk opp reiser selv."
          }
        }
      }
    },
    "location_needed_body_undecided": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Location access is needed to show routes and stops from where you are. Allow it now, or use PulseTransit as a wall board, which needs none."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Posisjonstilgang trengs for å vise reiser og holdeplasser fra der du er. Tillat det nå, eller bruk PulseTransit som veggtavle, som ikke trenger det."
          }
        }
      }
    },
    "location_needed_title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On the spot needs your location"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Der du er trenger posisjonen din"
          }
        }
      }
    },
    "location_rationale_body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On the spot finds the nearest stop and plans routes from where you stand. Your position is sent only to Entur, to find stops and routes, and to MET Norway for the weather."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Der du er finner nærmeste holdeplass og planlegger reiser fra der du står. Posisjonen sendes bare til Entur, for å finne holdeplasser og reiser, og til Meteorologisk institutt for været."
          }
        }
      }
    },
    "location_rationale_precise": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Precise location finds the nearest stop; approximate still works, less exactly."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Nøyaktig posisjon finner nærmeste holdeplass; omtrentlig fungerer også, men mindre presist."
          }
        }
      }
    },
    "location_rationale_title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use your location"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bruk posisjonen din"
          }
        }
      }
    },
    "location_rationale_turn_off": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can turn it off at any time in your phone’s settings."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan slå det av når som helst i telefonens innstillinger."
          }
        }
      }
    },
