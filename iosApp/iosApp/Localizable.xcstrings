    "intro_routes_body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add the places you often go to in Settings, and each gets its next routes from where you stand. For a one-off trip, tap the search button."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Legg til stedene du ofte skal til i Innstillinger, så får hvert av dem de neste reisene fra der du står. For en enkelt tur, trykk på søkeknappen."
          }
        }
      }
    },
    "intro_routes_title": {
      "extractionState": "manual",
      "localizations": {
