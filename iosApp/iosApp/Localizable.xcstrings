    "intro_choose_stops_body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Settings to add up to 6 stops, and pick which directions of each to show. When they don’t all fit, the board takes turns showing them."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Åpne Innstillinger for å legge til opptil 6 stoppesteder, og velg hvilke retninger som vises for hvert. Når ikke alle får plass, viser tavlen dem etter tur."
          }
        }
      }
    },
    "intro_choose_stops_title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose your stops"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Velg stoppestedene dine"
          }
        }
      }
    },
    "intro_details_body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap a departure to see its stops and later times, or to hide a line you never take. Tap a route to see every step and get alerts along the way."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Trykk på en avgang for å se stoppene og senere avganger, eller for å skjule en linje du aldri tar. Trykk på en reise for å se hvert steg og få varsler underveis."
          }
        }
      }
    },
    "intro_details_title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap for details"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Trykk for detaljer"
          }
        }
      }
    },
    "intro_done": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Get started"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kom i gang"
          }
        }
      }
    },
    "intro_fastest_routes_body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add up to 5 destinations in Settings to see the fastest way there from the board’s location, and choose when each one is shown, like weekday mornings."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Legg til opptil 5 reisemål i Innstillinger for å se den raskeste veien dit fra tavlens posisjon, og velg når hvert av dem vises, for eksempel hverdagsmorgener."
          }
        }
      }
    },
    "intro_fastest_routes_title": {
