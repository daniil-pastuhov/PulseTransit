    "board_empty_body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add up to 6 stops and pick which directions to show. The board keeps their departures up to date on its own."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Legg til opptil 6 stopp og velg hvilke retninger som skal vises. Tavla holder avgangene oppdatert av seg selv."
          }
        }
      }
    },
