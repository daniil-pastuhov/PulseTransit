    "intro_screen_care_body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Settings has burn-in protection, dimming when no one is around, waking by camera motion and a theme that follows the light in the room."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Innstillinger har innbrenningsvern, dimming når ingen er i nærheten, vekking ved bevegelse foran kameraet og et tema som følger lyset i rommet."
          }
        }
      }
    },
