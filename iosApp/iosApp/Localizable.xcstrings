    "camera_denied_body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "PulseTransit can’t use the front camera, so the board won’t wake by motion. It stays at full brightness instead of dimming, and you can still touch it."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "PulseTransit kan ikke bruke frontkameraet, så tavlen vekkes ikke av bevegelse. Den holder full lysstyrke i stedet for å dempes, og du kan fortsatt trykke på den."
          }
        }
      }
    },
    "camera_denied_title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Camera access is off"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kameratilgang er av"
          }
        }
      }
    },
    "camera_keep_off": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep it off"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "La det være av"
          }
        }
      }
    },
    "camera_rationale_body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "While the screen is dimmed, the front camera watches for movement and wakes the board."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Mens skjermen er dempet, ser frontkameraet etter bevegelse og vekker tavlen."
          }
        }
      }
    },
    "camera_rationale_nothing_kept": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing is recorded, saved or sent anywhere."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingenting tas opp, lagres eller sendes noe sted."
          }
        }
      }
    },
    "camera_rationale_on_device": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Frames never leave this device. Each one is compared with the last and thrown away."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bildene forlater aldri enheten. Hvert bilde sammenlignes med det forrige og kastes."
          }
        }
      }
    },
    "camera_rationale_sensitivity": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose how much motion wakes it in Settings, under Camera Sensitivity."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Velg hvor mye bevegelse som vekker den i Innstillinger, under Kamerafølsomhet."
          }
        }
      }
    },
    "camera_rationale_title": {
      "extractionState": "manual",
