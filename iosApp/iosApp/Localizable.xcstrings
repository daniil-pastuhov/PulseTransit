    "intro_resize_body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drag the bar between routes and departures to give either one more space."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Dra linjen mellom reiser og avganger for å gi en av dem mer plass."
          }
