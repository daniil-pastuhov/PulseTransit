    "intro_nearest_stop_body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The nearest stop’s departures show on their own and follow you as you move. Tap the stop’s name to pick another one nearby."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Avgangene fra nærmeste stoppested vises av seg selv og følger deg når du flytter deg. Trykk på navnet til stoppestedet for å velge et annet i nærheten."
          }
        }
      }
    },
    "intro_nearest_stop_title": {
      "extractionState": "manual",
      "localizations": {
