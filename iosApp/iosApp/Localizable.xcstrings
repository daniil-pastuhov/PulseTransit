    "journey_rationale_body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "PulseTransit can tell you when to leave, when your ride departs and when the next stop is yours. With your location it can also notice if you missed the ride."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "PulseTransit kan si fra når du bør gå, når avgangen går og når neste stopp er ditt. Med posisjonen din kan appen også merke om du gikk glipp av avgangen."
          }
        }
      }
    },
    "journey_rationale_cancel": {
      "extractionState": "manual",
      "localizations": {
