    "NSCameraUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The front camera wakes the screen when someone walks by. No images are stored or sent anywhere."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Frontkameraet vekker skjermen når noen går forbi. Ingen bilder lagres eller sendes noe sted."
          }
        }
      }
    },
    "NSLocationWhenInUseUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your location is used to find nearby stops, to show the weather where you are and to follow a journey you asked to be alerted about. A followed journey's location never leaves this device."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Posisjonen din brukes til å finne holdeplasser i nærheten, vise været der du er og følge en reise du har bedt om varsler for. Posisjonen under en fulgt reise forlater aldri denne enheten."
          }
        }
      }
    }
  },
  "version" : "1.0"
}