# TestFlight and App Store lanes for the iOS app, run by .github/workflows/ci.yml from iosApp/
#
#   bundle exec fastlane beta version:1.0.2 build_number:42   # build, upload to internal testers
#   bundle exec fastlane release version:1.0.2                # submit that version's build to the App Store
#   bundle exec fastlane metadata                             # push the App Store texts in fastlane/metadata
#
# All need an App Store Connect API key with the Admin role in ASC_KEY_ID, ASC_ISSUER_ID and
# ASC_KEY_P8 (the .p8 file's contents). Admin is what lets Xcode create the distribution
# certificate and profile itself (cloud-managed signing), so no certificates live in the repo.

# No usage analytics from CI runs that hold the App Store Connect key.
opt_out_usage

default_platform(:ios)

ROOT = File.expand_path("../..", __dir__)

platform :ios do
  # Release notes are written once per version by scripts/release and shared with Google Play.
  # TestFlight's "What to Test" is per language, like Play's "What's new".
  def build_info(version)
    notes = ->(locale) { File.read(File.join(ROOT, "release-notes/v#{version}/#{locale}.txt")).strip }
    {
      changelog: notes.call("en-US"),
      localized_build_info: {
        "default" => { whats_new: notes.call("en-US") },
        "no" => { whats_new: notes.call("no-NO") },
      },
    }
  end

  def api_key
    app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_content: ENV.fetch("ASC_KEY_P8"),
    )
  end

  # The flags that let xcodebuild sign with the API key instead of a logged-in Xcode account.
  def signing_xcargs
    key_path = File.join(Dir.tmpdir, "asc_api_key.p8")
    File.write(key_path, ENV.fetch("ASC_KEY_P8"))
    "-allowProvisioningUpdates -authenticationKeyPath #{key_path} " \
      "-authenticationKeyID #{ENV.fetch('ASC_KEY_ID')} -authenticationKeyIssuerID #{ENV.fetch('ASC_ISSUER_ID')}"
  end

  # The archive is signed with an Apple Development certificate, and a fresh CI runner has none, so
  # every run creates one through the API key whose private key is gone with the runner. Once the
  # team's certificate limit is reached signing fails, so the leftovers of earlier runs are revoked
  # first. Certificates last a year; those under a day old are kept, as another run may be using one.
  def revoke_stale_ci_certificates
    cutoff = Time.now + 364 * 24 * 3600
    Spaceship::ConnectAPI::Certificate.all(filter: { certificateType: "DEVELOPMENT" })
      .select { |cert| cert.display_name == "Created via API" && Time.parse(cert.expiration_date) < cutoff }
      .each do |cert|
        UI.message("Revoking #{cert.name} (#{cert.id}), left by an earlier CI run")
        cert.delete!
      end
  end

  desc "Build a signed release and upload it to TestFlight for internal testers"
  lane :beta do |options|
    version = options.fetch(:version)
    build_number = options.fetch(:build_number)
    key = api_key
    revoke_stale_ci_certificates
    derived_data = File.join(ROOT, "iosApp/build/DerivedData")

    build_app(
      project: File.join(ROOT, "iosApp/iosApp.xcodeproj"),
      scheme: "iosApp",
      configuration: "Release",
      export_method: "app-store",
      output_directory: File.join(ROOT, "iosApp/build"),
      derived_data_path: derived_data,
      # fastlane passes xcargs to the export step too, so the signing flags go here only once.
      xcargs: "#{signing_xcargs} CURRENT_PROJECT_VERSION=#{build_number}",
      export_options: { signingStyle: "automatic", teamID: "S8Q8KHX6G5" },
    )

    # Waits for App Store Connect to process the build: the release notes can only be set on a
    # processed build. Internal groups with automatic distribution then receive it; export
    # compliance is answered by ITSAppUsesNonExemptEncryption in the app's Info.plist.
    upload_to_testflight(
      api_key: key,
      distribute_external: false,
      **build_info(version),
    )

    # The Kotlin framework is static, so its code and symbols are in the app's own dSYM.
    upload_symbols_to_crashlytics(
      dsym_path: lane_context[SharedValues::DSYM_OUTPUT_PATH],
      gsp_path: File.join(ROOT, "iosApp/iosApp/GoogleService-Info.plist"),
      binary_path: File.join(derived_data, "SourcePackages/checkouts/firebase-ios-sdk/Crashlytics/upload-symbols"),
    )
  end

  desc "Update the App Store listing (texts, URLs, categories) from fastlane/metadata"
  lane :metadata do
    # The listing lives in the repo, like the Play listing in app/src/main/play, so changes are
    # reviewed in PRs. Screenshots and the binary are managed separately. Until the first App Store
    # release, deliver saves the texts and then fails with "No data" (fastlane#20538).
    deliver(
      api_key: api_key,
      metadata_path: File.join(ROOT, "iosApp/fastlane/metadata"),
      skip_binary_upload: true,
      skip_screenshots: true,
      force: true,
      submit_for_review: false,
      run_precheck_before_submit: false,
    )
  end

  desc "Submit the newest TestFlight build of a version for App Store review, released on approval"
  lane :release do |options|
    version = options.fetch(:version)
    key = api_key
    # The build testers have been trying is submitted as is, like the Play internal release.
    build_number = latest_testflight_build_number(api_key: key, version: version)

    app = Spaceship::ConnectAPI::App.find(CredentialsManager::AppfileConfig.try_fetch_value(:app_identifier))
    platform = Spaceship::ConnectAPI::Platform::IOS
    app.ensure_version!(version, platform: platform)
    edit_version = app.get_edit_app_store_version(platform: platform)
    # Released as soon as Apple approves it. deliver's automatic_release would only take effect
    # through the metadata upload skipped below.
    edit_version.update(attributes: { releaseType: Spaceship::ConnectAPI::AppStoreVersion::ReleaseType::AFTER_APPROVAL })

    # "What's New" is set here rather than by deliver's metadata upload, which would also delete the
    # App Review attachment (the screen recording the review notes refer to). App Store Connect
    # refuses it on an app's first version, so it is left out until a version has been released.
    if app.get_live_app_store_version(platform: platform)
      edit_version.get_app_store_version_localizations.each do |localization|
        notes = File.read(File.join(ROOT, "release-notes/v#{version}/#{localization.locale.start_with?('no', 'nb') ? 'no-NO' : 'en-US'}.txt")).strip
        localization.update(attributes: { whatsNew: notes })
      end
    end

    # Export compliance is answered by ITSAppUsesNonExemptEncryption in the app's Info.plist.
    deliver(
      api_key: key,
      app_version: version,
      build_number: build_number.to_s,
      skip_binary_upload: true,
      skip_metadata: true,
      skip_screenshots: true,
      force: true,
      submit_for_review: true,
      run_precheck_before_submit: false,
    )
  end
end
