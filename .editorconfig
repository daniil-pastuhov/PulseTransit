root = true

[*.{kt,kts}]
ktlint_code_style = ktlint_official
max_line_length = 140

# Composables are PascalCase by convention.
ktlint_function_naming_ignore_when_annotated_with = Composable

# The settings repository exposes its StateFlows through getXxxFlow() functions
# rather than matching properties, so the _xxx backing fields have no same-named
# public counterpart for this rule to find.
ktlint_standard_backing-property-naming = disabled

# Compose resources are generated as one extension property per string (Res.string.<name>), each
# needing its own import; the generated package is imported whole instead.
ij_kotlin_packages_to_use_import_on_demand = com.example.pulsetransit.ui.resources.*

# Generated code (Room's KSP output) is registered with the KMP source sets, so ktlint sees it.
# It is not ours to format.
[**/build/generated/**]
ktlint_standard = disabled
