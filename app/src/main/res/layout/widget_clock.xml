<?xml version="1.0" encoding="utf-8"?>
<!-- The compact widget's clock. A TextClock ticks on its own, which a Glance Text redrawn by the
     periodic refresh could not. It is 24-hour whatever the system's setting, like every time the
     app shows. The date below it is a Glance Text: a second TextClock was cut off by the host. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextClock
        android:id="@+id/widget_clock_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:format12Hour="HH:mm"
        android:format24Hour="HH:mm"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:textColor="@color/widget_text"
        android:textSize="40sp"
        android:textStyle="bold" />
</LinearLayout>
