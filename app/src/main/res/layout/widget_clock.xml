<?xml version="1.0" encoding="utf-8"?>
<!-- The compact widget's clock and date. A TextClock ticks on its own, which a Glance Text redrawn
     by the periodic refresh could not; the date's pattern is set per locale in code. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextClock
        android:id="@+id/widget_clock_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:format12Hour="h:mm"
        android:format24Hour="HH:mm"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:textColor="@color/widget_text"
        android:textSize="40sp"
        android:textStyle="bold" />

    <TextClock
        android:id="@+id/widget_clock_date"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:format12Hour="EEE d MMM"
        android:format24Hour="EEE d MMM"
        android:maxLines="1"
        android:textColor="@color/widget_text_secondary"
        android:textSize="14sp" />
</LinearLayout>
