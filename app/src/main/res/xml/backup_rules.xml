<?xml version="1.0" encoding="utf-8"?><!--
   Auto Backup rules for devices below API 31 (referenced via
   android:fullBackupContent). Once an <include> is present, only the
   included domains are backed up — settings live in SharedPreferences,
   while the Room offline cache (pulse_transit_cache.db) is disposable
   derived data and must not be restored onto a new device.
-->
<full-backup-content>
    <include domain="sharedpref" path="." />
</full-backup-content>
