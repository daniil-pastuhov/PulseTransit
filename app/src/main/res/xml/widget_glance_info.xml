<?xml version="1.0" encoding="utf-8"?>
<!-- updatePeriodMillis is 0: WidgetRefresh refreshes every widget through WorkManager instead.
     Attributes of newer Android versions are ignored on older ones, hence UnusedAttribute.
     Nothing to configure: it shows the first favourite stop, like the board's first panel. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:description="@string/widget_glance_description"
    android:initialLayout="@layout/glance_default_loading_layout"
    android:minWidth="180dp"
    android:minHeight="50dp"
    android:minResizeWidth="110dp"
    android:minResizeHeight="50dp"
    android:previewLayout="@layout/widget_preview_glance"
    android:resizeMode="horizontal|vertical"
    android:targetCellWidth="4"
    android:targetCellHeight="1"
    android:updatePeriodMillis="0"
    android:widgetCategory="home_screen"
    tools:ignore="UnusedAttribute" />
